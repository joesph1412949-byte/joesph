{
  "id": "sector_momentum",
  "name": "板块动量实验策略",
  "description": "8.23文档落地v4+v5实验: 板块强度(SEC1/SEC2/SEC3/SEC4/SEC6) + 形态动量(M1/M6), 门槛需宏观环境确认(N1+至少2个宏观), 卖出移动止盈(trailing 8%/5%)。板块综合评分链(动量35%+资金流25%+拥挤度30%+宏观10%, >75门槛+仓位加成)已实现但默认关闭——回测显示切换期保护显著(样本外+4.6% vs v4 -6.1%)但强市错杀严重(样本内+41.4%->-6.4%), 待资金流补齐+相对排名重设计后复评。SEC因子需市场数据层注入(mkt)。",
  "market_gate": {
    "model": "node",
    "threshold": 3,
    "factors": ["N1", "N6", "N7", "N8"]
  },
  "scoring_models": [
    {
      "id": "sector_strength",
      "name": "板块强度",
      "weight": 0.5,
      "factors": [
