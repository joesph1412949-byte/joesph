        {"id": "SEC2", "weight": 1.0},
        {"id": "SEC3", "weight": 1.0},
        {"id": "SEC4", "weight": 1.0},
        {"id": "SEC6", "weight": 1.0}
      ]
    },
    {
      "id": "momentum",
      "name": "形态动量",
      "weight": 0.5,
      "factors": [
        {"id": "M1", "weight": 1.0},
        {"id": "M6", "weight": 1.0}
      ]
    }
  ],
  "composite": {"mode": "sum", "cap": 5.0},
  "filters": {"candidate_min_model": 1, "environment_threshold": 1},
  "sell_rules": {
    "take_profit_pct": 0.08,
    "stop_loss_pct": 0.05,
    "max_hold_days": 5,
    "trailing_pct": [8, 5]
