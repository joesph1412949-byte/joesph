prism_web/_ui_backup_*/

# 运行期数据统一收纳目录(2026-09-14 目录重组):
#   runtime/cache/  采集缓存(可重建)   runtime/state/  账本与状态(不可重建)
#   runtime/log/    组件日志
# 内容一律不入库, 只保留目录骨架(.gitkeep), 保证克隆后开箱即可运行。
runtime/cache/*
runtime/state/*
runtime/log/*
!runtime/cache/.gitkeep
!runtime/state/.gitkeep
!runtime/log/.gitkeep

# 一次性采集/探测脚本/临时文档(不进 git)
pt_*
# 根目录一次性脚本/输出: 必须锚定 `/`, 否则会误伤 prism/_utils.py 这类子目录文件
/_*.py
/_*.txt
*.sw_backup.pkl

# Agent / tooling directories
.agents/
.workbuddy/
.codex/
deepseek-harness*/
scripts/

# 临时工具脚本（session-delete 开发辅助）
.tmp_tools/

